# rolify_cr — port of rolify 6.0.1 (ActiveRecord adapter).
#
# The Ruby gem mixes modules into classes at runtime; here the same
# surface is generated by two macros on ActiveRecord::Base (`rolify`,
# `resourcify`) plus one on the role class (`scopify`), following the
# devise_cr convention. Oracle: oracle/cases.rb over the original gem.

require "active_record_cr"

module Rolify
  # Rolify.configure equivalents. `dynamic_shortcuts` has no Crystal
  # equivalent (runtime method definition) and is kept for parity only.
  class_property dynamic_shortcuts : Bool = false
  class_property remove_role_if_empty : Bool = true

  # A resource argument: class, instance, `:any`, or none.
  alias ResourceRef = ActiveRecord::Base.class | ActiveRecord::Base | Symbol | Nil
  alias RoleName = Symbol | String

  # --- SQL builders (mirror of adapters/active_record/role_adapter) ------

  # SQL string literal ('..' with escaped quotes) — where() here takes
  # no bound args for Array inputs, so builders inline everything.
  def self.lit(v : String | Int64) : String
    v.is_a?(String) ? %('#{v.gsub('\'', "''")}') : v.to_s
  end

  # `build_query`: OR-chain matching global / class-scoped / instance-
  # scoped roles, fully inlined.
  def self.build_query(role_table : String, role : String, resource : ResourceRef) : String
    if resource == :any
      return %(#{role_table}.name = #{lit(role)})
    end
    query = %(((#{role_table}.name = #{lit(role)}) AND (#{role_table}.resource_type IS NULL) AND (#{role_table}.resource_id IS NULL)))
    if resource
      query = "(#{query} OR ((#{role_table}.name = #{lit(role)}) AND (#{role_table}.resource_type = #{lit(resource_type_of(resource))}) AND (#{role_table}.resource_id IS NULL))"
      unless resource.is_a?(ActiveRecord::Base.class)
        query += %( OR ((#{role_table}.name = #{lit(role)}) AND (#{role_table}.resource_type = #{lit(resource_type_of(resource))}) AND (#{role_table}.resource_id = #{resource_id_of(resource).not_nil!})))
      end
      query += ")"
    end
    query
  end

  # `where_strict`: exact resource match (no OR chain).
  def self.strict_query(role_table : String, role : String, resource : ResourceRef) : String
    if resource.is_a?(ActiveRecord::Base.class)
      %(#{role_table}.name = #{lit(role)} AND #{role_table}.resource_type = #{lit(resource_type_of(resource))} AND #{role_table}.resource_id IS NULL)
    else
      %(#{role_table}.name = #{lit(role)} AND #{role_table}.resource_type = #{lit(resource_type_of(resource))} AND #{role_table}.resource_id = #{resource_id_of(resource).not_nil!})
    end
  end

  def self.resource_type_of(resource) : String
    case resource
    when ActiveRecord::Base.class then resource.name
    when ActiveRecord::Base       then resource.class.name
    else                               ""
    end
  end

  def self.resource_id_of(resource) : Int64?
    resource.is_a?(ActiveRecord::Base) ? resource.id : nil
  end

  # resource_types_for: the class name (STI descendants are not walkable
  # at runtime in Crystal — documented deviation; oracle cases have no
  # STI resources).
  def self.resource_types_for(klass : ActiveRecord::Base.class) : Array(String)
    [klass.name]
  end

  def self.in_clause(values : Array(String)) : String
    values.map { |v| "'#{v.gsub('\'', "''")}'" }.join(", ")
  end

  # --- instance role API (lib/rolify/role.rb) -----------------------------

  module RoleMethods
    def add_role(role_name : RoleName, resource : ResourceRef = nil)
      role_class = self.class.role_class
      rt = resource ? Rolify.resource_type_of(resource) : nil
      rid = resource && !resource.is_a?(ActiveRecord::Base.class) ? Rolify.resource_id_of(resource) : nil
      role = role_class.where(name: role_name.to_s, resource_type: rt, resource_id: rid)
                       .first_or_create({"name" => role_name.to_s})
      unless role.id && self.roles.include?(role)
        self.roles << role
      end
      role
    end

    def grant(role_name : RoleName, resource : ResourceRef = nil)
      add_role(role_name, resource)
    end

    def has_role?(role_name : RoleName, resource : ResourceRef = nil) : Bool
      if self.class.strict_rolify? && resource && resource != :any
        return has_strict_role?(role_name, resource)
      end
      role_table = self.class.role_class.table_name
      sql = Rolify.build_query(role_table, role_name.to_s, resource)
      !self.roles.where(sql).to_a.empty?
    end

    def has_strict_role?(role_name : RoleName, resource : ResourceRef) : Bool
      role_table = self.class.role_class.table_name
      sql = Rolify.strict_query(role_table, role_name.to_s, resource)
      !self.roles.where(sql).to_a.empty?
    end

    def has_cached_role?(role_name : RoleName, resource : ResourceRef = nil) : Bool
      has_role?(role_name, resource)
    end

    def has_strict_cached_role?(role_name : RoleName, resource : ResourceRef = nil) : Bool
      has_strict_role?(role_name, resource)
    end

    def has_all_roles?(*args : Symbol | String | NamedTuple) : Bool
      args.each do |arg|
        case arg
        when NamedTuple then return false unless has_role?(arg[:name], arg[:resource]?)
        when Symbol, String then return false unless has_role?(arg)
        else
          raise ArgumentError.new("Invalid argument type: only hash or string or symbol allowed")
        end
      end
      true
    end

    def has_any_role?(*args : Symbol | String | NamedTuple) : Bool
      args.any? do |arg|
        case arg
        when NamedTuple then has_role?(arg[:name], arg[:resource]?)
        when Symbol, String then has_role?(arg)
        else
          raise ArgumentError.new("Invalid argument type: only hash or string or symbol allowed")
        end
      end
    end

    def only_has_role?(role_name : RoleName, resource : ResourceRef = nil) : Bool
      has_role?(role_name, resource) && self.roles.size.as(Int64) == 1_i64
    end

    def remove_role(role_name : RoleName, resource : ResourceRef = nil)
      role_table = self.class.role_class.table_name
      cond = %(#{role_table}.name = #{Rolify.lit(role_name.to_s)})
      if resource
        cond += %( AND #{role_table}.resource_type = #{Rolify.lit(Rolify.resource_type_of(resource))})
        unless resource.is_a?(ActiveRecord::Base.class)
          cond += %( AND #{role_table}.resource_id = #{Rolify.resource_id_of(resource).not_nil!})
        end
      end
      roles = self.roles.where(cond).to_a
      roles.each { |r| self.roles.delete(r) }
      remove_roles_if_empty(roles) if Rolify.remove_role_if_empty
      roles
    end

    # Mirror of the adapter's remove hook: a role with no users left on
    # this user class's join table is destroyed (rolify default).
    private def remove_roles_if_empty(roles)
      role_table = self.class.role_class.table_name
      jt = self.class.role_join_table_name
      target_col = ActiveRecord::Migrations.singularize(role_table) + "_id"
      roles.each do |role|
        next unless role_id = role.id
        has_users = false
        ActiveRecord::Base.__session.query(
          %(SELECT 1 FROM "#{jt}" WHERE "#{target_col}" = $1 LIMIT 1),
          args: [role_id]) do |rs|
          rs.each { has_users = true }
        end
        role.destroy unless has_users
      end
    end

    def revoke(role_name : RoleName, resource : ResourceRef = nil)
      remove_role(role_name, resource)
    end

    def roles_name : Array(String)
      self.roles.map { |r| r.name.to_s }
    end
  end

  # --- user-class finders (lib/rolify/finders.rb) --------------------------

  module Finders
    def with_role(role_name : RoleName, resource : ResourceRef = nil)
      rt = role_class.table_name
      join = role_join_clause(rt)
      strict = strict_rolify? && resource && resource != :any
      if strict
        sql = Rolify.strict_query(rt, role_name.to_s, resource)
      else
        sql = Rolify.build_query(rt, role_name.to_s, resource)
      end
      all.joins(join).where(sql)
    end

    def without_role(role_name : RoleName, resource : ResourceRef = nil)
      excluded = with_role(role_name, resource).ids
      if excluded.empty?
        all
      else
        where(%("#{table_name}"."#{primary_key}" NOT IN (#{excluded.join(", ")})))
      end
    end

    def with_all_roles(*args : Symbol | String | NamedTuple)
      users = with_role_for_arg(args[0]).to_a
      args.each do |arg|
        found = with_role_for_arg(arg).to_a
        users &= found
        return users if users.empty?
      end
      users
    end

    def with_any_role(*args : Symbol | String | NamedTuple)
      users = with_role_for_arg(args[0]).to_a
      i = 1
      while i < args.size
        users += with_role_for_arg(args[i]).to_a
        i += 1
      end
      users.uniq
    end

    private def with_role_for_arg(arg)
      case arg
      when NamedTuple then with_role(arg[:name], arg[:resource]?)
      when Symbol, String then with_role(arg)
      else
        raise ArgumentError.new("Invalid argument type: only hash or string or symbol allowed")
      end
    end

    def role_join_clause(role_table : String) : String
      jt = role_join_table_name
      owner = ActiveRecord::Migrations.singularize(table_name) + "_id"
      target = ActiveRecord::Migrations.singularize(role_table) + "_id"
      %(INNER JOIN "#{jt}" ON "#{jt}"."#{owner}" = "#{table_name}"."#{primary_key}" ) +
        %(INNER JOIN "#{role_table}" ON "#{role_table}"."id" = "#{jt}"."#{target}")
    end
  end

  # --- role class scopes (adapters/active_record/scopes.rb) ----------------

  module Scopes
    def global
      where("resource_type IS NULL AND resource_id IS NULL")
    end

    def class_scoped(resource_type : ActiveRecord::Base.class | Nil = nil)
      if resource_type
        where("resource_type = ? AND resource_id IS NULL", resource_type.name)
      else
        where("resource_type IS NOT NULL AND resource_id IS NULL")
      end
    end

    def instance_scoped(resource : ActiveRecord::Base.class | ActiveRecord::Base | Nil = nil)
      case resource
      when ActiveRecord::Base.class
        where("resource_type = ? AND resource_id IS NOT NULL", resource.name)
      when ActiveRecord::Base
        where("resource_type = ? AND resource_id = ?", resource.class.name, resource.id)
      else
        where("resource_type IS NOT NULL AND resource_id IS NOT NULL")
      end
    end
  end

  # --- resource side (lib/rolify/resource.rb) ------------------------------

  module ResourceClassMethods
    def find_roles(role_name : RoleName | Nil = nil)
      role_types_filter(role_class.all, role_name)
    end

    def find_roles(role_name : RoleName | Nil, user)
      role_types_filter(user.roles, role_name)
    end

    def with_role(role_name : RoleName | Array(String))
      with_role_impl(role_name, nil)
    end

    def with_role(role_name : RoleName | Array(String), user)
      with_role_impl(role_name, user)
    end

    def with_roles(role_name, user = nil)
      with_role(role_name, user)
    end

    def without_role(role_name : RoleName, user = nil)
      excluded = with_role(role_name, user).ids
      if excluded.empty?
        all
      else
        where(%("#{table_name}"."#{primary_key}" NOT IN (#{excluded.join(", ")})))
      end
    end

    def applied_roles(children : Bool = true)
      types = Rolify.resource_types_for(self.as(ActiveRecord::Base.class))
      if children
        role_class.where(%(resource_type IN (#{Rolify.in_clause(types)}) AND resource_id IS NULL))
      else
        role_class.where("resource_type = ? AND resource_id IS NULL", name)
      end
    end

    private def role_types_filter(roles, role_name)
      types = Rolify.resource_types_for(self.as(ActiveRecord::Base.class))
      roles = roles.where(%(resource_type IN (#{Rolify.in_clause(types)})))
      role_name && role_name != :any ? roles.where(name: role_name.to_s) : roles
    end

    private def with_role_impl(role_name, user)
      names = role_name.is_a?(Array) ? role_name.map(&.to_s) : [role_name.to_s]
      rt = role_class.table_name
      types = Rolify.resource_types_for(self.as(ActiveRecord::Base.class))
      join = %(INNER JOIN "#{rt}" ON "#{rt}".resource_type IN (#{Rolify.in_clause(types)}) AND ) +
             %((("#{rt}".resource_id IS NULL) OR ("#{rt}".resource_id = "#{table_name}"."#{primary_key}")))
      rel = joins(join).where(%("#{rt}".name IN (#{Rolify.in_clause(names)}) AND "#{rt}".resource_type IN (#{Rolify.in_clause(types)})))
      if user
        role_ids = user.roles.where(%(name IN (#{Rolify.in_clause(names)}))).map(&.id.not_nil!)
        rel = rel.where(%("#{rt}"."id" IN (#{role_ids.empty? ? "0" : role_ids.join(", ")}) AND ) +
                        %((("#{rt}".resource_id = "#{table_name}"."#{primary_key}") OR ("#{rt}".resource_id IS NULL))))
      end
      rel
    end
  end

  module ResourceMethods
    def applied_roles
      self.roles.to_a + self.class.applied_roles(true).to_a
    end
  end
end

class ActiveRecord::Base
  # rolify: HABTM roles on the user class. Join table naming follows the
  # gem: "#{user_table}_#{role_table}", overridable via role_join_table_name.
  # HABTM callbacks (before_add/after_add/before_remove/after_remove) are
  # passed through to the CollectionProxy, as in the gem.
  macro rolify(role_cname = "Role", strict = false, role_join_table_name = nil,
               before_add = nil, after_add = nil, before_remove = nil,
               after_remove = nil)
    include ::Rolify::RoleMethods
    extend ::Rolify::Finders

    def self.role_class : {{role_cname.id}}.class
      {{role_cname.id}}
    end

    def self.strict_rolify? : Bool
      {{strict}}
    end

    def self.role_join_table_name : String
      {{role_join_table_name}} || "#{table_name}_#{ {{role_cname.id}}.table_name }"
    end

    def roles : ::ActiveRecord::CollectionProxy({{role_cname.id}})
      jt = self.class.role_join_table_name
      owner_col = ::ActiveRecord::Migrations.singularize(self.class.table_name) + "_id"
      target_col = ::ActiveRecord::Migrations.singularize({{role_cname.id}}.table_name) + "_id"
      sql = %("id" IN (SELECT "#{target_col}" FROM "#{jt}" WHERE "#{owner_col}" = ?))
      proxy = ::ActiveRecord::CollectionProxy({{role_cname.id}}).new({{role_cname.id}}, {{role_cname.id}}.where(sql, @id || -1_i64))
      proxy.__init_habtm(jt, owner_col, target_col, @id)
      {% if before_add || after_add || before_remove || after_remove %}
        proxy.__init_callbacks(self,
          {% if before_add %} [ {% for m in (before_add.is_a?(ArrayLiteral) ? before_add : [before_add]) %} ->(o : ::ActiveRecord::Base, r : {{role_cname.id}}) { o.as({{@type}}).{{m.id}}(r); nil }, {% end %} ] of ::Proc(::ActiveRecord::Base, {{role_cname.id}}, Nil) {% else %} nil {% end %},
          {% if after_add %} [ {% for m in (after_add.is_a?(ArrayLiteral) ? after_add : [after_add]) %} ->(o : ::ActiveRecord::Base, r : {{role_cname.id}}) { o.as({{@type}}).{{m.id}}(r); nil }, {% end %} ] of ::Proc(::ActiveRecord::Base, {{role_cname.id}}, Nil) {% else %} nil {% end %},
          {% if before_remove %} [ {% for m in (before_remove.is_a?(ArrayLiteral) ? before_remove : [before_remove]) %} ->(o : ::ActiveRecord::Base, r : {{role_cname.id}}) { o.as({{@type}}).{{m.id}}(r); nil }, {% end %} ] of ::Proc(::ActiveRecord::Base, {{role_cname.id}}, Nil) {% else %} nil {% end %},
          {% if after_remove %} [ {% for m in (after_remove.is_a?(ArrayLiteral) ? after_remove : [after_remove]) %} ->(o : ::ActiveRecord::Base, r : {{role_cname.id}}) { o.as({{@type}}).{{m.id}}(r); nil }, {% end %} ] of ::Proc(::ActiveRecord::Base, {{role_cname.id}}, Nil) {% else %} nil {% end %})
      {% end %}
      proxy
    end
  end

  # resourcify: the resource side (roles pointing at this class through
  # the polymorphic `resource` columns).
  macro resourcify(association_name = "roles", role_cname = "Role")
    include ::Rolify::ResourceMethods
    extend ::Rolify::ResourceClassMethods

    def self.role_class : {{role_cname.id}}.class
      {{role_cname.id}}
    end

    def {{association_name.id}} : ::ActiveRecord::CollectionProxy({{role_cname.id}})
      if rid = @id
        proxy_rel = {{role_cname.id}}.where(resource_type: self.class.name, resource_id: rid)
      else
        proxy_rel = {{role_cname.id}}.none
      end
      ::ActiveRecord::CollectionProxy({{role_cname.id}}).new({{role_cname.id}}, proxy_rel)
    end
  end

  # scopify: role-class scopes (global / class_scoped / instance_scoped).
  macro scopify
    extend ::Rolify::Scopes
  end
end
